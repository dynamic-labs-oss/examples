<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:screenOrientation="portrait"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Passed as `metadata.nativeLink` when creating the Dynamic client
             (see dynamicClient.ts). MetaMask's SDK reduces it to this scheme
             and embeds it in the pairing URI so the MetaMask app can offer a
             "return to app" affordance after the user approves the
             connection — approval itself still resolves over the SDK's own
             relay session either way. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="bareflowmetamaskdemo" />
        </intent-filter>
      </activity>
    </application>

    <!-- Android 11+ package-visibility rules: without these, Linking can't
         see whether an app that handles https:// or wc: links (e.g.
         MetaMask, WalletConnect-compatible wallets) is installed. See
         https://www.dynamic.xyz/docs/javascript/react-native/bare-react-native -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wc" />
        </intent>
    </queries>
</manifest>
