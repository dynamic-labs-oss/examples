# Dynamic environment
NEXT_PUBLIC_DYNAMIC_ENV_ID=
NEXT_PUBLIC_DYNAMIC_API_BASE=https://app.dynamicauth.com/api/v0
DYNAMIC_API_TOKEN=

# Automation
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
DEFAULT_GAS_RESERVE=0.005
RPC_URL_8453=https://mainnet.base.org

# Delegation webhook (needed when Dynamic can reach your server, e.g. via tunnel)
DYNAMIC_WEBHOOK_SECRET=
DYNAMIC_DELEGATION_PRIVATE_KEY=

# Optional Supabase persistence (falls back to .data/db.json when unset)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
