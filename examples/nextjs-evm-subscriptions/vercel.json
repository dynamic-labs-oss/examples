{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "schedules": {
    "collect-pulls": {
      "schedule": "0 * * * *",
      "path": "/api/cron/collect",
      "requestMethod": "GET"
    },
    "collect-solana-pulls": {
      "schedule": "5 * * * *",
      "path": "/api/cron/collect-solana",
      "requestMethod": "GET"
    }
  }
}
