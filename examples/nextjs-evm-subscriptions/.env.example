# Required: Dynamic environment ID from https://app.dynamic.xyz
NEXT_PUBLIC_DYNAMIC_ENV_ID=your-environment-id-here

# Required: Merchant EVM address that receives each pull
NEXT_PUBLIC_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000

# Supabase project (https://supabase.com) — stores subscriptions and the
# pre-signed pull authorizations. Service role key stays server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Relayer key that broadcasts transferWithAuthorization for due pulls
# (direct mode). Fund it with a little Base Sepolia ETH for gas.
RELAYER_PRIVATE_KEY=0x...

# Optional: Base Sepolia RPC override (defaults to the public endpoint)
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
RPC_URL=https://sepolia.base.org

# Optional: cron auth — when set, /api/cron/collect requires this Bearer token
CRON_SECRET=

# Optional: plan overrides
NEXT_PUBLIC_PLAN_AMOUNT=100000          # 0.10 USDC
NEXT_PUBLIC_PLAN_PERIOD_SECONDS=3600    # hourly
NEXT_PUBLIC_PLAN_PULLS=4

# Optional: Relay executor (mainnet — testnet solvers don't carry USDC)
# RELAY_API_URL=https://api.relay.link
# RELAY_API_KEY=
