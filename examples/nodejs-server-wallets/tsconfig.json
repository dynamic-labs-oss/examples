{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "target": "es2022",
    // viem's `ox` dependency ships TypeScript sources that reference DOM types
    // (WebAuthn), so the DOM lib is required even though this runs on Node.
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "inlineSourceMap": true,
    "outDir": "./dist/src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "./dist/**/*", "./**/*.spec.ts"]
}
