DYNAMIC_API_TOKEN=
DYNAMIC_ENVIRONMENT_ID=

# REQUIRED for EVM operations. Read-only EVM RPC endpoint, used for EIP-7702
# delegation checks, EOA nonces, and transaction receipts.
#
# There is no public-endpoint fallback on purpose: sepolia.base.org is heavily rate
# limited and regularly returns "no backend is currently healthy to serve traffic",
# which makes a correct setup look broken. Point this at a provider you control.
#
# Not needed for the Solana examples, message signing, or wallet management.
RPC_URL=

# Optional. Solana RPC endpoint. Used for reads AND to broadcast transactions:
# Dynamic sponsors SVM fees by swapping the fee payer, but your server still
# submits the signed transaction. Defaults to public devnet (rate limited).
SOLANA_RPC_URL=

# Optional. Cluster label for Solana explorer links. Defaults to devnet.
SOLANA_CLUSTER=
